# Development uses persistent local demo Postgres. Production requires Supabase.
DEMO_MODE=true
# Never enable demo admin on public deployments.
DEMO_ADMIN=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CRON_SECRET=
# Enable Turnstile in Supabase Auth settings before public signup.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
